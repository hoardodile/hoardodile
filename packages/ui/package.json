{
	"name": "@hoardodile/ui",
	"version": "0.1.2",
	"license": "MIT",
	"description": "shadcn/ui component library for hoardodile plugin iframes.",
	"keywords": [
		"hoardodile",
		"plugin",
		"ui",
		"shadcn",
		"react"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hoardodile/hoardodile.git",
		"directory": "packages/ui"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./theme.css": {
			"development": "./src/styles/theme.css",
			"default": "./dist/styles/theme.css"
		},
		"./lib/*": {
			"types": "./dist/lib/*.d.ts",
			"development": "./src/lib/*",
			"default": "./dist/lib/*.js"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"development": "./src/components/*",
			"default": "./dist/components/*.js"
		},
		"./icons/*": {
			"types": "./dist/icons/*.d.ts",
			"development": "./src/icons/*",
			"default": "./dist/icons/*.js"
		},
		"./hooks/*": {
			"types": "./dist/hooks/*.d.ts",
			"development": "./src/hooks/*",
			"default": "./dist/hooks/*.js"
		},
		"./viewport": {
			"types": "./dist/viewport.d.ts",
			"development": "./src/viewport.ts",
			"default": "./dist/viewport.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": [
		"*.css"
	],
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "pnpm build",
		"build": "tsup",
		"lint": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hoardodile/i18n": "workspace:*",
		"@solar-icons/react": "catalog:",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"react-hook-form": "^7.86.0",
		"react-image-crop": "^11.1.2",
		"react-use": "catalog:",
		"tailwind-merge": "^3.6.0"
	},
	"peerDependencies": {
		"i18next": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-i18next": "catalog:",
		"shadcn": "^4.16.1",
		"tailwindcss": "catalog:",
		"tw-animate-css": "^1.4.0"
	},
	"peerDependenciesMeta": {
		"shadcn": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		},
		"tw-animate-css": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/oxide": "^4.3.3",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "^14.6.6",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"shadcn": "^4.19.0",
		"tailwindcss": "catalog:",
		"tsup": "catalog:",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.3"
	}
}
