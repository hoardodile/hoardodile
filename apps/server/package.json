{
	"name": "@hoardodile/server",
	"version": "0.0.0",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./router": {
			"types": "./src/infra/trpc/router.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"app-server": "./bin/app-server.mjs",
		"app-server-reset": "./bin/app-server-reset.mjs"
	},
	"scripts": {
		"dev": "vite-node --watch src/main.ts",
		"start": "node --enable-source-maps dist/main.js",
		"reset": "node dist/reset-main.js",
		"reset:dev": "vite-node src/reset-main.ts",
		"seed": "vite-node src/seed-main.ts",
		"bench": "vite-node bench/run.ts",
		"build": "vite build",
		"lint": "tsc --noEmit",
		"test": "vitest run --exclude bench/**",
		"test:coverage": "vitest run --coverage --exclude bench/**",
		"test:bench": "vitest run bench",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "catalog:",
		"@types/semver": "catalog:",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"@vitest/coverage-v8": "^5.0.5",
		"drizzle-kit": "^0.31.11",
		"pino-pretty": "^13.2.0",
		"tinybench": "^6.2.2",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-node": "catalog:",
		"vitest": "catalog:",
		"yauzl": "^3.4.0",
		"yazl": "^3.3.1"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.3",
		"@fastify/cors": "^11.3.1",
		"@fastify/multipart": "^10.1.6",
		"@fastify/rate-limit": "^11.2.1",
		"@fastify/sse": "^0.6.1",
		"@fastify/static": "^10.1.7",
		"@hoardodile/backup": "workspace:*",
		"@hoardodile/host": "workspace:*",
		"@hoardodile/i18n": "workspace:*",
		"@hoardodile/schemas": "workspace:*",
		"@hoardodile/sdk-server": "workspace:*",
		"@hoardodile/sdk-types": "workspace:*",
		"@hoardodile/shared": "workspace:*",
		"@hoardodile/ui": "workspace:*",
		"@node-rs/argon2": "^2.2.2",
		"@trpc/server": "^11.19.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"es-toolkit": "catalog:",
		"eventemitter3": "^5.0.4",
		"fastify": "^5.12.7",
		"fastify-plugin": "^6.0.1",
		"get-port": "^7.2.0",
		"iron-session": "^9.0.1",
		"pino": "^10.4.0",
		"pino-roll": "^4.0.0",
		"semver": "catalog:",
		"sharp": "catalog:",
		"zod": "catalog:"
	}
}
