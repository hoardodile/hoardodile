{
	"name": "@hoardodile/workbench",
	"version": "0.1.6",
	"license": "MIT",
	"description": "Offline dev workbench for hoardodile content plugins.",
	"keywords": [
		"hoardodile",
		"plugin",
		"workbench",
		"dev",
		"mock"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hoardodile/hoardodile.git",
		"directory": "plugins/workbench"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/serve.d.mts",
			"default": "./dist/serve.mjs"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "pnpm build",
		"dev": "node scripts/dev.mjs",
		"build": "vite build && node scripts/copy-serve.mjs",
		"lint": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@hoardodile/host-web": "workspace:*",
		"@hoardodile/i18n": "workspace:*",
		"@hoardodile/sdk-types": "workspace:*",
		"@hoardodile/sdk-web": "workspace:*",
		"@hoardodile/ui": "workspace:*",
		"@playwright/test": "catalog:",
		"@rolldown/plugin-babel": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"babel-plugin-react-compiler": "catalog:",
		"i18next": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-i18next": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
