{
	"name": "@hoardodile/host-web",
	"version": "0.0.0",
	"license": "MIT",
	"description": "Browser-side hoardodile host runtime: host-core protocol router and the offline mock host.",
	"keywords": [
		"hoardodile",
		"plugin",
		"host",
		"browser",
		"mock"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hoardodile/hoardodile.git",
		"directory": "plugins/host-web"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"development": "./src/node.ts",
			"default": "./dist/node.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "pnpm build",
		"build": "tsup",
		"lint": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hoardodile/host": "workspace:*",
		"@hoardodile/sdk-types": "workspace:*",
		"@hoardodile/sdk-web": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"jsdom": "catalog:",
		"tsup": "catalog:",
		"typescript": "5.9.3",
		"vitest": "catalog:"
	}
}
