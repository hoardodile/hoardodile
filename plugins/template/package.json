{
	"name": "@hoardodile/plugin-template",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "hoardodile plugin dev",
		"build": "hoardodile plugin build",
		"watch": "hoardodile plugin build --watch",
		"detect:smoke": "hoardodile plugin run detect testdata --plugin-dir dist",
		"lint": "biome check . && tsc --noEmit",
		"format": "biome check --write",
		"lint-staged": "lint-staged --max-arg-length=6000",
		"postinstall": "node scripts/setup-hooks.mjs",
		"test": "vitest run",
		"readme:check": "node scripts/check-readme.mjs",
		"release": "node scripts/release.mjs"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version}",
			"tagName": "v${version}",
			"requireBranch": "main"
		},
		"github": {
			"release": false
		},
		"npm": {
			"publish": false
		},
		"plugins": {
			"@release-it/conventional-changelog": {
				"preset": {
					"name": "conventionalcommits"
				},
				"infile": "CHANGELOG.md"
			}
		},
		"hooks": {
			"after:bump": "node scripts/sync-version.mjs"
		}
	},
	"dependencies": {
		"@hoardodile/sdk-react": "workspace:*",
		"@hoardodile/sdk-server": "workspace:*",
		"@hoardodile/sdk-types": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@hoardodile/cli": "workspace:*",
		"@hoardodile/host": "workspace:*",
		"@hoardodile/workbench": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"jsdom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"release-it": "catalog:",
		"@release-it/conventional-changelog": "catalog:",
		"@biomejs/biome": "catalog:",
		"lefthook": "catalog:",
		"lint-staged": "catalog:"
	}
}
