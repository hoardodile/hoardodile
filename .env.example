# Copy this file to `.env` and adjust values for your local dev environment.
# `.env` is gitignored by default.

# Node environment: development | test | production
NODE_ENV=development

# Server bind address and port
HOST=127.0.0.1
PORT=3000

# Where the server keeps the live DB, shared version archives, and local caches.
# Defaults to the OS temp directory if not set.
STORAGE_ROOT=./tmp/dev-storage

# Optional: override the live DB path (mostly used by tests).
# DATABASE_URL=./tmp/dev-storage/app.sqlite

# Optional: root directory exposed by the shared-folder import browser.
# SHARED_FOLDER_ROOT=./tmp/dev-storage

# Pre-built web assets directory. In production this is bundled next to main.js.
APP_WEB_ROOT=./apps/web/dist

# Builtin fallback plugin directory.
BUILTIN_PATH=./plugins/file/dist

# Extra dev plugin dist directories, appended to the DEV_PLUGINS mapping
# (loaded by the server as-is; no watchers are started for these).
# DEV_PLUGIN_PATHS=C:/dev/plugin-a/dist

# Comma-separated plugin directories for `pnpm dev` (absolute, or relative
# to the repo root). Each must contain a manifest.json; a `watch` script
# there is started when present. Defaults to the official in-repo content
# plugins so `pnpm dev` comes up with the previewer set.
DEV_PLUGINS=./plugins/gallery

# Plugin dist directories (absolute, or relative to the repo root) seeded
# into {storage}/versions/<latest>/plugins on every server start when the
# on-disk tree differs, so they behave like installed plugins (DB
# settings, asset caching, uninstall). Defaults to the official in-repo
# content plugin dists so a bare start ships the previewer set. Set empty
# to disable seeding.
SEED_PLUGIN_PATHS=./plugins/gallery/dist

# Logging level
LOG_LEVEL=info

# Session cookie settings
SESSION_COOKIE_NAME=app_session
SESSION_TTL_SECONDS=2592000
SESSION_SECURE_COOKIE=false

# Force HTTPS redirects / Secure cookies when behind a TLS-terminating proxy
FORCE_HTTPS=false

# Disable loading dev plugins (recommended for public-facing deployments)
DISABLE_DEV_PLUGINS=false

# Upload/extraction limits (bytes)
MAX_UPLOAD_BYTES=17179869184
MAX_ARCHIVE_EXTRACTED_BYTES=68719476736
# Max compressed size for plugin zip uploads (bytes)
# PLUGIN_UPLOAD_MAX_BYTES=268435456

# Optional ffmpeg/ffprobe binary overrides
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Plugin sandbox (worker threads) tuning. Defaults shown.
# PLUGIN_WATCHDOG_TIMEOUT_MS=60000
# PLUGIN_HOOK_HARD_TIMEOUT_MS=1800000
# PLUGIN_WORKER_MAX_OLD_SPACE_MB=512
