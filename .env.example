# Copy this file to `.env` and adjust values for your local dev environment.
# `.env` is gitignored by default; relative paths resolve against the repo root.
#
# Convention: uncommented `VAR=value` lines are safe dev defaults; commented
# `# VAR=value` lines are optional overrides (value shown = server default).

# ── Runtime ────────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Server bind address and port
HOST=127.0.0.1
PORT=3000

# Logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Storage ────────────────────────────────────────────────────────────────

# Where the server keeps the live DB (app.sqlite), frozen version archives
# (versions/<v>/), and local caches. Defaults to the OS temp dir when unset.
STORAGE_ROOT=./tmp/dev-storage

# Optional: override the live DB path. In real deployments the DB lives at
# <STORAGE_ROOT>/app.sqlite; only tests use this override (`:memory:`).
# DATABASE_URL=./tmp/dev-storage/app.sqlite

# Optional: root directory exposed by the shared-folder import browser.
# Unset → shared-folder import disabled (zip-upload import remains available).
# SHARED_FOLDER_ROOT=/path/to/shared/folder

# ── Serving ────────────────────────────────────────────────────────────────

# Pre-built web assets directory. Unset in production (bundled next to
# main.js); with `pnpm dev` the banner is served by the Vite dev server and
# this path only matters when opening the server port directly.
APP_WEB_ROOT=./apps/web/dist

# Builtin fallback plugin directory (manifest.json + main.js + render.js).
BUILTIN_PATH=./plugins/file/dist

# ── Plugins ────────────────────────────────────────────────────────────────

# Comma-separated plugin directories for `pnpm dev` (absolute, or relative to
# the repo root). Each must contain a manifest.json; its `watch` script is
# started when present. Unset → `pnpm dev` runs without any plugin watches
# (here: the in-repo previewer gallery).
DEV_PLUGINS=./plugins/gallery

# Extra dev plugin dist directories, appended to the DEV_PLUGINS mapping
# (loaded by the server as-is; no watchers are started for these).
# DEV_PLUGIN_PATHS=C:/dev/plugin-a/dist

# Plugin dist directories (absolute, or relative to the repo root) seeded into
# `{storage}/versions/<latest>/plugins` on every server start when the on-disk
# tree differs, so they behave like installed plugins (DB settings, asset
# caching, uninstall). Unset → no seeding (bare-server default); `pnpm dev`
# defaults it to the DEV_PLUGINS selection's dists.
SEED_PLUGIN_PATHS=./plugins/gallery/dist

# Ignore dev plugin directories (recommended for public-facing deployments).
DISABLE_DEV_PLUGINS=false

# ── Sessions & TLS ─────────────────────────────────────────────────────────

# Session cookie name
SESSION_COOKIE_NAME=app_session

# Session idle timeout in seconds — env fallback for the
# auth.sessionIdleTimeoutSeconds system preference (default: 7 days). Stored
# preference values are clamped to 60 s .. 365 d.
SESSION_TTL_SECONDS=604800

# Both to true when behind a TLS-terminating reverse proxy: forces HTTPS
# redirects and the cookie Secure flag.
SESSION_SECURE_COOKIE=false
FORCE_HTTPS=false

# ── Size limits (bytes) ────────────────────────────────────────────────────

# Max size of a single resource upload (default: 16 GiB)
MAX_UPLOAD_BYTES=17179869184

# Max cumulative bytes written to disk when extracting an archive upload
# (zip-bomb guard; default: 64 GiB = 4× MAX_UPLOAD_BYTES)
MAX_ARCHIVE_EXTRACTED_BYTES=68719476736

# Max uncompressed bytes one plugin `extractArchive` call may write to the
# extraction cache (default: 8 GiB)
# MAX_PLUGIN_EXTRACT_BYTES=8589934592

# Max entry count one plugin `extractArchive` call may materialize
# (default: 200000)
# MAX_PLUGIN_EXTRACT_ENTRIES=200000

# Max compressed plugin zip upload size (default: 256 MiB)
# PLUGIN_UPLOAD_MAX_BYTES=268435456

# ── Media ──────────────────────────────────────────────────────────────────

# Optional ffmpeg/ffprobe binary overrides; when unset, the bundled static
# packages or PATH resolve them instead.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ── Plugin sandbox (worker threads) ────────────────────────────────────────

# Kill a plugin worker when an invocation neither returns nor shows
# resource-API activity for this long (default: 60 s; API calls keep
# resetting the watchdog).
# PLUGIN_WATCHDOG_TIMEOUT_MS=60000

# Absolute cap for a single plugin hook invocation, regardless of activity
# (default: 30 min).
# PLUGIN_HOOK_HARD_TIMEOUT_MS=1800000

# V8 old-generation memory cap per plugin worker, in MiB (default: 512)
# PLUGIN_WORKER_MAX_OLD_SPACE_MB=512

# ── Automatic snapshots ────────────────────────────────────────────────────

# Take one DB snapshot into `{storage}/versions/<latest>/snapshots` per local
# day (with a catch-up run at boot when the newest snapshot is stale); keep
# the AUTO_SNAPSHOT_KEEP newest files.
AUTO_SNAPSHOT_ENABLED=true
AUTO_SNAPSHOT_KEEP=3

# Skip automatic snapshots (and flag the volume as low on space) when fewer
# than this many bytes are free on the storage volume (default: 5 GiB)
# MIN_FREE_DISK_BYTES=5368709120

# ── Maintenance ────────────────────────────────────────────────────────────

# First-run tag/namespace dedupe: log what it would merge without changing
# data (preview the merge list before upgrading; default: false)
# TAG_DEDUPE_DRY_RUN=false

# ── Desktop only ───────────────────────────────────────────────────────────

# Shared secret for desktop sidecar control routes; the shell injects a
# per-spawn value. Self-host: leave unset (the routes exist, every request
# is 401).
# HOARDODILE_SHUTDOWN_TOKEN=
