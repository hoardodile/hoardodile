{
	"$schema": "./node_modules/turbo/schema.json",
	"futureFlags": { "globalConfiguration": true },
	"global": {
		"inputs": ["tsconfig.json", "pnpm-workspace.yaml"],
		"env": ["CI", "NODE_ENV"],
		"passThroughEnv": ["CI", "GITHUB_*", "TURBO_*"]
	},
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "out/**"]
		},
		"lint": {
			// Type checks resolve package exports, which point at dist — lint
			// against fresh build artifacts so local results match CI (which
			// builds before linting). Builds are cached by turbo.
			"dependsOn": ["^build", "build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/biome.json",
				"!.turbo/**",
				"!public/**",
				"!e2e/**"
			]
		},
		"test": {
			// Package exports now point at dist, so tests resolve built
			// artifacts; build workspace dependencies AND this package
			// first (its own dist may be stale on disk from other tools).
			"dependsOn": ["^build", "build"],
			"outputs": [],
			"inputs": ["$TURBO_DEFAULT$", "!.turbo/**", "!public/**", "!e2e/**"]
		},
		"test:coverage": {
			"dependsOn": ["^build", "build"],
			"outputs": [],
			"inputs": ["$TURBO_DEFAULT$", "!.turbo/**", "!public/**", "!e2e/**"]
		}
	}
}
